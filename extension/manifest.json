{
  "manifest_version": 3,
  "name": "Swipe Mark - Multi-Browser Two-Way Sync",
  "version": "1.3.0",
  "description": "Export, organize, rename, and unbookmark bookmarks from Chrome, Brave, Firefox, Edge with Shift+B quick bookmarking and real-time two-way sync.",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://swipemark.himanshutamoli.site/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://swipemark.himanshutamoli.site/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://swipemark.himanshutamoli.site/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "commands": {
    "quick-bookmark": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Bookmark current tab into Bookmark Swipe"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Swipe Mark",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
